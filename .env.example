# ==========================================================
# 🎓 Online Test Platform & Certificate Generator (.env.example)
# ==========================================================

# 1. Flask Session & Encryption Secret Key
# Generate a secure key in production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-me-to-a-very-secure-random-secret-key-12345

# 2. Teacher / Admin Portal Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# 3. Production PostgreSQL Database URL
# Required for persistent production storage on Vercel / Cloud
# Compatible with Neon, Supabase, Vercel Postgres, AWS RDS, Render PostgreSQL
DATABASE_URL=postgresql://username:password@ep-sample-123.region.aws.neon.tech/neondb?sslmode=require

# 4. Strict Database Persistence Flag (true/false)
# If true, app will refuse to boot with ephemeral storage
REQUIRE_PERSISTENT_DB=false

# 5. Public Application Base URL
# Local: http://localhost:5000 | Vercel Production: https://testportalgvt.vercel.app
APP_URL=http://localhost:5000

# 6. Demo Test Seeding Flag (true/false)
# Set to false in production to prevent auto-inserting sample test
SEED_DEMO=false

# 7. School & Institute Branding
PORTAL_NAME=Online Test Portal
INSTITUTE_NAME=GVT
