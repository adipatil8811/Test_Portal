# Flask Secret Key (generate a random string for production)
SECRET_KEY=change-me-to-a-very-secure-random-secret-key-12345

# Teacher Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345

# Public Base URL
# Local Development: http://localhost:5000
# Production Deployment: https://your-production-app.onrender.com (or custom domain)
APP_URL=http://localhost:5000

# Database URL (Leave empty to use local SQLite, or set for PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Portal & School Details
PORTAL_NAME=Online Test Portal
INSTITUTE_NAME=GVT
